# clk on AA14, IO_L11P_T1_SRCC_13 of xc7z015clg485: a clock-capable pad of
# bank 13. led on V13, IO_L1P_T0_13. Same dialect as the generated
# constraints.
set_property PACKAGE_PIN AA14 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
set_property PACKAGE_PIN V13 [get_ports led]
set_property IOSTANDARD LVCMOS33 [get_ports led]
