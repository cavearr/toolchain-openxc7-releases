#!/usr/bin/env bash
# Lives in libexec/, a sibling of bin/. The package root is the parent
# of this directory, the same relation bin/ had. PATH is bin/: libexec/
# holds the binaries without their wrappers, and apio does not put
# libexec/ on PATH (apio#1116).
release_dir="$(dirname "${BASH_SOURCE[0]}")"
release_topdir_abs="$(readlink -f "$release_dir/..")"
export PATH="$release_topdir_abs/bin:$PATH"
export PYTHONEXECUTABLE="$release_topdir_abs/libexec/tabbypy3"
export PYTHONHOME="$release_topdir_abs"
export PYTHONNOUSERSITE=1
#export SSL_CERT_FILE="$release_topdir_abs"/etc/cacert.pem
# The packer replaces this marker with the loader exec from
# pack.relocate.linux_loader_exec (the directory is pack.PRIVATE_LIB).
@LINUX_LOADER_EXEC@
